{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Valo Overlay",
  "version": "1.4.1",
  "identifier": "fr.valooverlay.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "overlay",
        "title": "Valo Overlay",
        "url": "index.html",
        "width": 1760,
        "height": 990,
        "center": true,
        "decorations": false,
        "shadow": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": true,
        "minWidth": 900,
        "minHeight": 520,
        "maximizable": false,
        "minimizable": false,
        "backgroundColor": "#0f1923",
        "focus": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "publisher": "Valo Overlay",
    "shortDescription": "Rangs et carrières des joueurs de ta partie Valorant",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["French"],
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
