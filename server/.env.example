# Nom de domaine qui pointe vers le VPS (enregistrement A) : HTTPS automatique
DOMAIN=valo.exemple.fr

# Clé HenrikDev (https://docs.henrikdev.xyz) : reste sur le serveur, jamais dans l'application
HENRIK_KEY=HDEV-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Jeton partagé avec l'application (config.json : "apiToken"). Génère-le avec : openssl rand -hex 24
APP_TOKEN=

# Optionnel
# RATE_PER_MIN=240        requêtes par minute et par joueur
# CACHE_MEMORY_MB=256     cache en mémoire
# CACHE_DISK_MB=4000      matchs gardés sur disque (compressés, ~40 Ko chacun)
# MAX_WAIT_S=25           attente maximale quand le quota HenrikDev de la minute est épuisé
